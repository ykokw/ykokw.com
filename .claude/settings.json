{
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm check)",
      "Bash(pnpm test*)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm run*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "ask": [
      "Bash(git push*)"
    ],
    "deny": [
      "Bash(sudo*)",
      "Bash(su*)",
      "Bash(git config --global*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "zenn.dev",
        "cdn.jsdelivr.net",
        "github.com"
      ]
    }
  }
}
